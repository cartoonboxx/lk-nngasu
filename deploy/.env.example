# Скопируйте в /var/www/lk-nngasu/.env и заполните секреты.
# Для каждого значения отдельно выполните: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

ACCESS_TTL=12h
# true для HTTPS. Если сервер временно доступен по HTTP, установите false.
COOKIE_SECURE=true
WEEK_ONE_DATE=2026-09-01

# Одноразовая настройка первого владельца на /setup; отдельный случайный ключ.
ADMIN_SETUP_KEY=83437a24a12ae8976825d61cb0e7dec2ff3ca22f9a613339439cdb51edcdef7c
# Публичный адрес фронтенда для ссылок из писем (HTTPS в production).
APP_URL=https://cabinet.example.ru
# SMTP с STARTTLS для приглашений администраторов.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
