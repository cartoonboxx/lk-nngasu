HTTP_ADDR=:8080
DATABASE_URL=postgres://uni:uni@localhost:5432/university_cabinet?sslmode=disable
# минимум 32 символа, например: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
# refresh-токенов нет, поэтому TTL сделан длинным; сократите, когда добавите refresh
ACCESS_TTL=12h

# Файлы: каталог хранилища и лимит на один файл (по ТЗ — 15 МБ)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# Расписание
TIMEZONE=Europe/Moscow
# любая дата ПЕРВОЙ (верхней) недели; без неё верхней считается нечётная ISO-неделя
WEEK_ONE_DATE=2026-09-01
# в БД хранится только время начала пары; конец = начало + это значение
LESSON_MINUTES=90
