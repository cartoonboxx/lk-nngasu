HTTP_ADDR=:8080
# При старте API применяет новые миграции из migrations/ (уже применённые пропускает).
# false — не трогать базу: тогда обновлять её командой make migrate.
MIGRATE_ON_START=true
DATABASE_URL=postgres://uni:uni@localhost:5432/university_cabinet?sslmode=disable
# минимум 32 символа, например: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
# Короткий access-токен; продлевается через POST /auth/refresh по refresh-cookie
ACCESS_TTL=15m

# Авторизация
# Одноразовая настройка владельца на /setup. Пусто — настройка отключена.
# Создать ключ: openssl rand -hex 32. После настройки ключ можно удалить.
# Никогда не передавать его в VITE_* и не использовать JWT_SECRET вместо этого ключа.
ADMIN_SETUP_KEY=
# Secure у refresh-cookie. true — только по HTTPS (браузер не сохранит cookie на http://,
# кроме localhost). Пока сервер работает по http, ставьте false.
COOKIE_SECURE=true
# Дополнительные адреса фронтенда через запятую, если он на другом домене/порту, чем API
# (например, dev-сервер Vite). Свой адрес API разрешён всегда.
ALLOWED_ORIGINS=http://localhost:5173
# Версия условий использования; фронт отправляет её в terms_version при регистрации
TERMS_VERSION=2026-11-13
# Адрес фронтенда: из него строится ссылка активации <APP_URL>/activation#token=...
APP_URL=http://localhost:5173

# Почта для приглашений (порт 587, STARTTLS). Для администраторов SMTP обязателен.
# Без SMTP_HOST доставка обычных приглашений откладывается; содержимое не выводится в лог.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Файлы: каталог хранилища и лимит на один файл, МБ
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# Расписание
TIMEZONE=Europe/Moscow
# любая дата ПЕРВОЙ (верхней) недели; без неё номер недели не считается (409 academic_calendar_not_configured)
WEEK_ONE_DATE=2026-09-01
# длительность пары в минутах: по ней считаются запланированные в шаблоне часы нагрузки
LESSON_MINUTES=90

# Сетка звонков: пары "начало-конец" через запятую. Занятие можно поставить только
# на одну из них (последняя пара — 80 минут). Пусто — время не сверяется с сеткой.
# LESSON_BELLS=08:00-09:30,...,18:35-19:55
LESSON_BELLS=
